# Copy to `.env` (git-ignored) and adjust. Docker Compose reads it automatically.

# PostgreSQL (the `db` service)
POSTGRES_USER=studybetter
POSTGRES_PASSWORD=studybetter
POSTGRES_DB=studybetter
# Host port for PostgreSQL; change it if 5432 is already in use.
DB_PORT=5432

# Server (the `server` service)
SERVER_PORT=8080
# Secret used to sign JWTs. Generate one with `openssl rand -hex 32`, or in
# PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# If empty, the server generates a random secret at startup and tokens stop
# working after a restart.
JWT_SECRET=

# When running the server with `dart run bin/server.dart` instead of Docker,
# set these in your shell (defaults match the values above):
#   PORT=8080
#   DATABASE_URL=postgres://studybetter:studybetter@localhost:5432/studybetter
